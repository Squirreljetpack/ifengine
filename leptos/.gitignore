# Generated by Cargo
/target/
Cargo.lock

# Leptos / cargo-leptos outputs
# (site root containing compiled wasm, js, and generated server bundles)
/target/site/
site/

# Trunk (if using Trunk instead of cargo-leptos)
dist/
.stage/

# Tailwind / CSS build artifacts
/style/*.css
!/style/main.css
!/style/input.css

# Node / JS dependencies (if using npm/npx for Tailwind, PostCSS, or esbuild)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secrets
.env
.env.*
!.env.example

# OS Generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.zed/